{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "**/scripts/**",
      "**/_shots/**",
      "README.md",
      "package.json",
      "package-lock.json"
    ],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      },
      {
        "source": "**/*.css",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      },
      {
        "source": "**/*.html",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      },
      {
        "source": "/",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      }
    ]
  }
}
